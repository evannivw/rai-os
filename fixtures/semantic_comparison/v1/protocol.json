{
  "version": 1,
  "cases": [
    "explicit",
    "historical",
    "latest",
    "ambiguous",
    "unavailable",
    "field",
    "unit",
    "time",
    "conflict",
    "checklist",
    "unknown-unit",
    "no-default"
  ],
  "repetitions": 2,
  "policies": [
    "rules",
    "meta"
  ],
