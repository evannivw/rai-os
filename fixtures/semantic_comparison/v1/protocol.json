  "fallback": false,
  "build": "release",
  "model": "muse-spark-1.3",
  "max_tokens": 1024,
  "reasoning_effort": "minimal",
  "schema": "rai_selection",
  "future_events": false,
  "workload": "independent development cases; fresh guest per accepted selection"
}
