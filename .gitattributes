# Raw UART captures use CRLF; preserve bytes and recognize CR as a line ending.
docs/evidence/2026-10-30-record-index-*.txt -text whitespace=cr-at-eol
docs/evidence/2026-10-30-display-*.txt -text whitespace=cr-at-eol
docs/evidence/2026-10-30-coord-index-*.txt -text whitespace=cr-at-eol
docs/evidence/2026-10-30-bundle-*.txt -text whitespace=cr-at-eol
docs/evidence/2026-10-31-publication/*.log -text whitespace=cr-at-eol
docs/evidence/2026-10-31-publication-display/*.log -text whitespace=cr-at-eol

# Keep Linux build inputs portable when cloned with Windows core.autocrlf=true.
*.rs text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.S text eol=lf
*.ld text eol=lf
*.toml text eol=lf
*.lock text eol=lf
fixtures/** text eol=lf
assets/**/*.txt text eol=lf
assets/**/*.md text eol=lf
host/**/*.md text eol=lf
scripts/**/*.md text eol=lf
portable/**/*.md text eol=lf
portable/Dockerfile text eol=lf
.dockerignore text eol=lf
.gitattributes text eol=lf

# Preserve verbatim UART/tool output, including CRLF and trailing empty lines.
