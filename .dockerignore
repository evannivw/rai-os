# Deny by default: credentials, Git metadata, host build outputs never enter context.
**
!.dockerignore
!.gitattributes
!Cargo.toml
!Cargo.lock
!rust-toolchain.toml
!linker.ld
!.cargo
!.cargo/config.toml
!src
!src/**
!scripts
!scripts/**
!host
!host/**
!fixtures
!fixtures/**
!assets
!assets/**
!portable
!portable/**
**/target
**/target/**
**/__pycache__
**/__pycache__/**
**/.env
**/.env.*
**/*.pem
**/*.key
